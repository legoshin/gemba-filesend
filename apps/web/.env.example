# Gemba Filesend — environment variables
# Copy to .env.local and fill in. All values are optional for local dev.

# --- Storage (production) -------------------------------------------------
# Vercel Blob token. When set, files are stored in Vercel Blob (production);
# when unset, files are stored on the local filesystem (development).
BLOB_READ_WRITE_TOKEN=

# Local filesystem storage directory (fs mode only). Defaults to ./data.
GEMBA_STORAGE_DIR=

# --- Cleanup cron ---------------------------------------------------------
# Bearer token the Vercel Cron cleanup endpoint authenticates with. When
# unset, the cleanup route allows manual triggering (dev only).
CRON_SECRET=

# --- Upstash Redis (SEC-02 rate limiting + REL-01 atomic download counter) --
# ONE shared Upstash Redis store backs both per-IP rate limiting and the
# atomic download counter (D-10). When these are unset, rate limiting is
# disabled (allow-all) and the counter uses a single-instance in-memory dev
# shim — set both in production so throttling and the download-limit
# invariant are actually enforced.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Rate-limit thresholds (optional; sliding window, per minute) ---------
# Defaults applied when unset: upload 10/min/IP, download 30/min/IP,
# password 5/min per (file id + IP). Breaches return HTTP 429 + Retry-After.
RATE_LIMIT_UPLOAD_PER_MIN=10
RATE_LIMIT_DOWNLOAD_PER_MIN=30
RATE_LIMIT_PASSWORD_PER_MIN=5
