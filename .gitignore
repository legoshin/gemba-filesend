# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# unanchored (was /node_modules) so it also matches per-workspace copies
# under apps/*/node_modules after the 05-01 monorepo restructure
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
# unanchored so vitest coverage output under apps/*/coverage is also ignored
coverage/

# next.js
# unanchored so apps/web/.next/ and apps/web/out/ are also ignored post-move
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# uploaded file storage
# unanchored so apps/web/data/ (GEMBA_STORAGE_DIR default, cwd-relative to
# the workspace package) is also ignored post-move
data/

# local tool state
/.omc/

# Android / Bubblewrap build artefacts and signing keys — NEVER commit
# the keystore or anything derived from it. Path prefix updated to
# apps/web/android/ after the 05-01 monorepo restructure.
apps/web/android/android.keystore
apps/web/android/android.keystore.lock
apps/web/android/*.keystore
apps/web/android/build/
apps/web/android/app/build/
apps/web/android/.gradle/
apps/web/android/local.properties
apps/web/android/twa.iml
apps/web/android/app-release-bundle.aab
apps/web/android/app-release-signed.apk

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but track the committed template (contains no secrets)
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# Expo (apps/mobile) — local cache, CNG-generated native dirs (never
# committed; regenerated by prebuild/EAS build), and Metro export output.
.expo/
apps/mobile/dist/
apps/mobile/ios/
apps/mobile/android/
apps/mobile/expo-env.d.ts
apps/mobile/.expo/
